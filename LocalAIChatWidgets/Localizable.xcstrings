      }
    },
    "上下文从这里开始": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context starts here"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文從這裡開始"
          }
        }
      }
    },
    "上下文快满了。超出部分模型会看不到；可以开新对话，或在助手设置里减少「记忆的历史消息」条数（开启长对话摘要时，早期内容会被压缩保留）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The context is almost full. The model won’t see anything beyond the limit; start a new chat, or reduce “History messages remembered” in the assistant settings (with long-chat summaries on, earlier content is condensed and kept)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文快滿了。超出部分模型會看不到；可以開新對話，或在助手設定裡減少「記憶的歷史訊息」條數（開啟長對話摘要時，早期內容會被壓縮保留）。"
          }
        }
      }
    },
    "上下文窗口": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context window"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文視窗"
