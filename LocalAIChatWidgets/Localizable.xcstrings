    "点击右上角 + 创建一个助手": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to create an assistant"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右上角 + 建立一個助手"
          }
