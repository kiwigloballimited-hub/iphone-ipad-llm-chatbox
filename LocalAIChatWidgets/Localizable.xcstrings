            "value": "開啟 %@"
          }
        }
      }
    },
    "打开 App 并和某个助手开始新对话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app and start a new chat with an assistant."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 App 並和某個助手開始新對話。"
          }
        }
      }
    },
    "打开 App，直接开始语音输入，说完即可发送给助手。适合设置到 iPhone 的操作按钮。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app and start voice input straight away; send it to the assistant when you finish speaking. Great for the iPhone Action Button."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 App，直接開始語音輸入，說完即可傳送給助手。適合設定到 iPhone 的動作按鈕。"
          }
        }
      }
    },
    "打开 iPhone「设置 › 操作按钮」，滑到「快捷指令」，选择「本地AI › 语音提问」。之后按住操作按钮就能直接说话提问。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open iPhone Settings › Action Button, swipe to Shortcut, and choose Local AI › Voice Ask. Then press and hold the Action Button to ask by voice."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 iPhone「設定 › 動作按鈕」，滑到「捷徑」，選擇「本地AI › 語音提問」。之後按住動作按鈕就能直接說話提問。"
          }
        }
      }
    },
    "打开「快捷指令」App，点 ＋ 新建，添加操作「本地AI › 发送给助手」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Shortcuts app, tap + to create a shortcut, and add the action Local AI › Send to Assistant."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「捷徑」App，點 ＋ 新建，新增操作「本地AI › 傳送給助手」。"
          }
        }
      }
    },
    "找不到编号为 [%lld] 的元素。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No element numbered [%lld] was found."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
