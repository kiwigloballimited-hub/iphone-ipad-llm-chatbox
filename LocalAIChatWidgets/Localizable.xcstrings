    "\n\n提示：API Key 无效或没有权限，请在服务器设置中检查 API Key。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nTip: the API key is invalid or lacks permission. Check the API key in the server settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n提示：API Key 無效或沒有權限，請在伺服器設定中檢查 API Key。"
          }
        }
      }
    },
    "\n\n提示：服务器繁忙，请稍后再试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nTip: the server is busy. Please try again later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n提示：伺服器繁忙，請稍後再試。"
          }
        }
      }
    },
    "\n\n提示：请求太频繁或额度已用完，请稍后再试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nTip: too many requests or your quota is used up. Please try again later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n提示：請求太頻繁或額度已用完，請稍後再試。"
          }
        }
      }
    },
    "\n\n提示：账户余额不足。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nTip: insufficient account balance."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n提示：賬戶餘額不足。"
          }
        }
      }
    },
    "\n\n（回答被中止：Claude 拒绝继续。）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Answer stopped: Claude declined to continue.)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n（回答被中止：Claude 拒絕繼續。）"
          }
        }
      }
    },
    "\n……（文档较长，后面的内容已省略）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n…(The document is long; the rest has been omitted.)"
