          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記住 %lld 條"
          }
        }
      }
    },
    "已选 %lld / %lld 帧": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld frames selected"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選 %lld / %lld 幀"
          }
        }
      }
    },
    "带「≈」的数字是按字数估算的（服务器没有返回用量，或回复还没有结束）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers marked “≈” are estimated from text length (the server didn’t report usage, or the reply hasn’t finished)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶「≈」的數字是按字數估算的（伺服器沒有返回用量，或回覆還沒有結束）。"
          }
        }
      }
    },
    "帧 JPEG 质量": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame JPEG quality"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幀 JPEG 質量"
          }
        }
      }
    },
    "帧分辨率（最长边）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame resolution (longest edge)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幀解析度（最長邊）"
          }
        }
      }
    },
    "帧数：%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames: %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幀數：%lld"
          }
        }
      }
    },
    "帧越多、分辨率越高，模型理解得越细，但请求更大、速度更慢。大多数视觉模型 6–12 帧即可。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More frames and higher resolution help the model understand more detail, but make requests larger and slower. 6–12 frames are enough for most vision models."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幀越多、解析度越高，模型理解得越細，但請求更大、速度更慢。大多數視覺模型 6–12 幀即可。"
          }
        }
      }
    },
    "并提交": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and submitted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "並提交"
          }
        }
      }
    },
    "开启后，助手可以搜索、打开网页、阅读内容、点击和输入。需要支持工具调用（function calling）的模型，例如 Qwen3、DeepSeek、Claude、gpt-oss、Llama 3.1+。登录、付款、提交表单等操作会先请求你的确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the assistant can search, open web pages, read content, tap and type. Requires a model that supports tool calling (function calling), such as Qwen3, DeepSeek, Claude, gpt-oss or Llama 3.1+. Logging in, paying, submitting forms and similar actions ask for your confirmation first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，助手可以搜尋、開啟網頁、閱讀內容、點選和輸入。需要支援工具呼叫（function calling）的模型，例如 Qwen3、DeepSeek、Claude、gpt-oss、Llama 3.1+。登入、付款、提交表單等操作會先請求你的確認。"
          }
        }
      }
    },
