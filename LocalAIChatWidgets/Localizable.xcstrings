          "stringUnit": {
            "state": "translated",
            "value": "已置頂，始終傳送給模型"
          }
        }
      }
    },
    "已覆盖到 %@ 之前的消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers messages before %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已覆蓋到 %@ 之前的訊息"
          }
        }
      }
    },
    "已记住 %lld 条": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
