    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地AI"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地AI"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used when you ask questions by voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音提问时需要使用麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音提問時需要使用麥克風。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition turns what you say into text for your AI assistant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你说的话转换成文字，发送给 AI 助手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把你說的話轉換成文字，傳送給 AI 助手。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network access is needed to connect to the AI server on your network (such as Ollama or LM Studio)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问本地网络，以连接你在局域网中运行的 AI 服务器（如 Ollama、LM Studio）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要存取本地網路，以連線你在區域網路中執行的 AI 伺服器（如 Ollama、LM Studio）。"
          }
        }
      }
    },
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalAIChat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalAIChat"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalAIChat"
          }
        }
      }
    }
  },
  "version": "1.0"
